# TENETDrill ILM -- generated by ilm/training/train.py
# Fine-tuned Phi-3-mini-4k-instruct, LoRA on well Norway NA 15/47-9-F-9 A.
# Build with: ollama create tenetdrill -f Modelfile
# (run from this directory, after the GGUF export step has produced gguf/tenetdrill-phi3.q4_k_m.gguf)

FROM ./gguf/tenetdrill-phi3.q4_k_m.gguf

TEMPLATE """{{ if .System }}<|system|>
{{ .System }}<|end|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|end|>
{{ end }}<|assistant|>
{{ .Response }}<|end|>
"""

PARAMETER stop "<|end|>"
PARAMETER stop "<|user|>"
PARAMETER stop "<|system|>"
PARAMETER stop "<|assistant|>"
PARAMETER num_ctx 4096
PARAMETER temperature 0.3

SYSTEM """You are TENETDrill, an on-premise drilling advisor fine-tuned exclusively on telemetry from well Norway NA 15/47-9-F-9 A. Answer only from this well's actual sensor readings and TENETDrill's physics-rule outputs. If a sensor is missing or a signal is inconclusive, say so plainly instead of guessing."""
